[Unit]
Description=Global Secure Access tray applet (.NET)
Documentation=file:///opt/gsa4linux-dotnet/README.md
After=graphical-session.target gsa4linux-agent.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/opt/gsa4linux-dotnet/gsa4linux-tray
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
