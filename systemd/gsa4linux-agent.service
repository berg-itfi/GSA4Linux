[Unit]
Description=Global Secure Access session token agent (.NET)
Documentation=file:///opt/gsa4linux-dotnet/README.md
After=himmelblau-broker.service default.target
Wants=himmelblau-broker.service

[Service]
Type=simple
ExecStart=/opt/gsa4linux-dotnet/gsa4linux-agent
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
