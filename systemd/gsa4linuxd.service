[Unit]
Description=Microsoft Global Secure Access tunnel daemon (.NET, unofficial)
Documentation=file:///opt/gsa4linux-dotnet/README.md
Wants=himmelblaud.service network-online.target
After=himmelblaud.service network-online.target NetworkManager.service

[Service]
Type=simple
ExecStart=/opt/gsa4linux-dotnet/gsa4linuxd
Environment=GSA4LINUX_CHANNELS=Private,M365
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# GSA-001/GSA-002: the session user allowed to drive the local token/control sockets.
# Set this to the primary interactive user's uid so the sockets are locked to them (0600 + chown).
Environment=GSA4LINUX_UID=674891046
Restart=on-failure
RestartSec=5
RuntimeDirectory=gsa4linux
RuntimeDirectoryMode=0755
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true
ProtectHome=read-only
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc /run
# GSA-010: modest additional sandboxing (kept compatible with the TUN/route/DNS work the daemon does).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ProtectHostname=true
ProtectKernelModules=true

[Install]
WantedBy=multi-user.target
